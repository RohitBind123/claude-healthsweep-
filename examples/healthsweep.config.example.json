{
  "groundTruth": ["README.md", "docs/SPEC.md"],
  "activeWork": ["docs/current-sprint.md"],
  "scope": ["src/api", "src/core"],
  "exclude": ["src/legacy"],
  "notes": "TypeScript API on Node 20 with PostgreSQL. All timestamps are UTC.",
  "checks": [
    {
      "name": "unit-api",
      "kind": "test",
      "cmd": "npx jest src/api",
      "cwd": "backend",
      "timeoutSec": 900,
      "scope": ["backend/src/api/**"]
    },
    {
      "name": "unit-core",
      "kind": "test",
      "cmd": "npx jest src/core",
      "cwd": "backend",
      "timeoutSec": 900,
      "scope": ["backend/src/core/**"]
    },
    {
      "name": "typecheck",
      "kind": "lint",
      "cmd": "npx tsc --noEmit",
      "cwd": "backend",
      "timeoutSec": 600
    },
    {
      "name": "build",
      "kind": "build",
      "cmd": "npm run build",
      "cwd": "backend",
      "timeoutSec": 900
    },
    {
      "name": "bench-api",
      "kind": "bench",
      "cmd": "node bench/api.mjs",
      "cwd": "backend",
      "metricRegex": "p95=([\\d.]+)ms",
      "timeoutSec": 300
    }
  ],
  "worktreeSetup": "ln -s {repoRoot}/backend/node_modules backend/node_modules",
  "costGate": { "threshold": "MEDIUM" },
  "benchTolerancePct": 10,
  "tier3": { "enabled": true, "effort": "medium" }
}
